# GEMINI_API_KEY: Required for Gemini Generative Try-On API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Cloud Run env vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# TRYON_PROVIDER: AI model provider ('gemini' by default, or 'replicate', 'fal_ai')
TRYON_PROVIDER="gemini"

# VITE_API_BASE_URL: Backend URL for the client/Android APK to call (leave empty for same origin)
# e.g., "https://trial-room-app-xxxx-uc.a.run.app"
VITE_API_BASE_URL=""
